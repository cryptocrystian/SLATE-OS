# SLATE — Persistence/Auth env scaffolding
#
# Copy this file to `.env.local` and fill in real values from the Supabase
# project dashboard. Never commit `.env.local`. Never prefix the service
# role key with `NEXT_PUBLIC_` — it must remain server-only.

# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key (Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Project Settings → API → service_role)
# Server-only. Do NOT prefix with NEXT_PUBLIC_. Do NOT reference from
# any code that ships to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used by Supabase magic-link redirect)
# Local dev: http://localhost:3000
# Production: https://<your-deployed-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Operator allowlist (server-only, never NEXT_PUBLIC_).
#
# `signInWithMagicLink` rejects any email that is not in either list. If
# both are empty, every email is rejected (fail-closed). At least one of
# these must be set for sign-in to work in any environment.
#
# Comma-separated. Trim/case are normalized.
# ---------------------------------------------------------------------------

# Comma-separated exact emails allowed to sign in to /app.
SLATE_OPERATOR_EMAIL_ALLOWLIST=

# Comma-separated bare domains (no `@`) — every email at these domains
# may sign in. Default for SLATE deployment is `saipienlabs.com`.
SLATE_OPERATOR_DOMAIN_ALLOWLIST=saipienlabs.com

# ---------------------------------------------------------------------------
# AI provider (server-only, never NEXT_PUBLIC_).
#
# AI Synthesis Step 1 generates draft findings via the configured provider.
# When `OPENAI_API_KEY` is absent, the findings synthesis button renders a
# controlled "AI synthesis is not configured" state and the build stays
# clean. Manual finding entry remains available regardless.
# ---------------------------------------------------------------------------

# Active AI provider. Currently only `openai` is wired. Leave unset to
# disable AI synthesis entirely.
SLATE_AI_PROVIDER=openai

# OpenAI API key. Server-only. Do NOT prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Optional override for the model used in findings synthesis. Defaults
# to `gpt-4o-mini`.
SLATE_AI_FINDINGS_MODEL=
