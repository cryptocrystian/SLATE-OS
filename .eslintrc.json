{
  "extends": "next/core-web-vitals",
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "excludedFiles": [
        "lib/governance/**",
        "app/app/governance/**",
        "components/governance/**",
        "tests/governance/**",
        "lib/build/**",
        "app/app/build/**",
        "components/build/**",
        "tests/build/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/lib/governance/*", "!@/lib/governance/contracts"],
                "message": "GovernanceOS boundary (docs/72 §1.3): other SLATE modules may import only @/lib/governance/contracts."
              },
              {
                "group": ["@/lib/build/*", "!@/lib/build/contracts", "@/components/build/*"],
                "message": "BuildOS boundary (docs/80 §1.5): other SLATE modules may import only @/lib/build/contracts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["lib/governance/**", "app/app/governance/**", "components/governance/**", "tests/governance/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/lib/build/*", "!@/lib/build/contracts", "@/components/build/*"],
                "message": "BuildOS boundary (docs/80 §1.5): other SLATE modules may import only @/lib/build/contracts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["lib/build/**", "app/app/build/**", "components/build/**", "tests/build/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/lib/governance/*", "!@/lib/governance/contracts", "@/components/governance/*"],
                "message": "BuildOS reaches GovernanceOS only via @/lib/governance/contracts (docs/80 §1.5)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["lib/platform/**", "lib/auth/**", "lib/activity/**", "lib/supabase/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/lib/governance/*", "@/lib/governance", "@/lib/build/*", "@/lib/build"],
                "message": "Platform code never depends on a module (docs/72 §1.3, docs/80 §1.5)."
              }
            ]
          }
        ]
      }
    }
  ]
}
